{
  "name": "app",
  "version": "0.0.0",
  "homepage": "https://hireicon.github.io/Hires",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href='./'",
    "api": "openapi-generator-cli generate -i src/swagger/swagger.json -g typescript-angular -o src/app/api --additional-properties=fileNaming=kebab-case,basePath='https://hiresapi.azurewebsites.net'",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/cdk": "^16.2.5",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/material": "^16.2.5",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@fortawesome/angular-fontawesome": "^0.13.0",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@types/intl-tel-input": "^18.1.1",
    "@types/underscore": "^1.11.9",
    "awesome-phonenumber": "^3.3.0",
    "bootstrap": "^5.3.2",
    "intl-tel-input": "^18.2.1",
    "jquery": "^3.7.1",
    "moment": "^2.29.4",
    "ng-recaptcha": "^12.0.2",
    "ngx-doc-viewer": "^15.0.1",
    "ngx-quill": "^23.0.0",
    "ngx-scrollbar": "^13.0.3",
    "ngx-toastr": "^17.0.2",
    "popper.js": "^1.16.1",
    "quill": "^1.3.7",
    "rxjs": "~7.8.0",
    "talkjs": "^0.18.0",
    "tslib": "^2.3.0",
    "underscore": "^1.13.6",
    "viewerjs": "^1.11.6",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.3",
    "@angular/cli": "~16.2.3",
    "@angular/compiler-cli": "^16.2.0",
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~4.3.0",
    "@types/jquery": "^3.5.19",
    "@types/node": "^20.6.5",
    "@types/quill": "1.3",
    "gh-pages": "^6.0.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^5.0.1",
    "typescript": "~5.1.3"
  }
